# 협업 충돌 자동 해소 규칙 (2026-07-31 신설 — COLLAB.md 참조)
#
# 두 개발자가 동시에 작업할 때 실제로 부딪히는 파일은 사람이 쓴 코드가 아니라
# 로봇이 매일 새로 쓰는 기록장이다. 이런 파일은 "누구 것이 맞나"를 고를 필요 없이
# 둘을 합치면 되므로, git이 충돌을 만나면 전용 병합기를 부르도록 지정한다.
#
# ⚠️ 이 지정이 실제로 동작하려면 `bash tools/setup-collab.sh`가 한 번 실행돼 있어야 한다
#    (git의 안전 규칙 — 저장소 파일이 임의의 프로그램을 자동 실행하지 못하게 막혀 있다).
#    Claude 세션은 시작 훅이 자동 실행하고, 로봇 워크플로는 저장 단계 전에 실행한다.

# ── 로봇 기록장: 합집합으로 자동 해소 ──────────────────────────────
data/notices.json            merge=jsonunion
collector/seen.json          merge=jsonunion
collector/pending-forms.json merge=jsonunion
collector/health.json        merge=jsonunion
# 대외활동·공모전 (2026-09-25) — 장학 피드와 같은 성격의 로봇 기록장이라 같은 규칙
data/activities.json         merge=jsonunion
collector/seen-activities.json merge=jsonunion
# 재단·지자체 공고 (2026-09-26)
data/external.json           merge=jsonunion
collector/seen-external.json merge=jsonunion
# 대외활동·재단 출처의 연속 실패 장부 (2026-10-05 · collector/source-health.mjs) — health.json 과 같은 모양이라 같은 병합기(최근 성공 쪽 · 실패 수는 작은 쪽)
collector/source-health.json merge=jsonunion

# ── 매 실행 새로 쓰이는 리포트: 내 쪽을 남긴다(다음 수집이 어차피 덮어쓴다) ──
# ⚠️ 리포트를 쓰는 로봇을 새로 만들면 **여기에 반드시 한 줄 추가할 것**.
#    빠뜨리면 그 리포트가 양쪽에서 달라질 때 배포 동기화가 충돌로 멈춘다 —
#    2026-08-01에 link-hunt-report.md가 이 목록에 없어서 실제로 그랬다(이슈 #85·#86).
collector/report.md          merge=ours
collector/browser-report.md  merge=ours
collector/deepfetch-report.md merge=ours
collector/link-hunt-report.md merge=ours
collector/kosaf-attach-report.md merge=ours
collector/find-boards-report.md merge=ours

# ── 수집된 원본 첨부: 내용 비교가 의미 없는 이진 파일로 취급 ──────────
collector/extracted/**       -diff

# 사람이 큐레이션하는 data/registered.json·data/forms.json은 일부러 넣지 않았다.
# 거기서는 '삭제'가 의미를 가지므로(잘못 등록분 제거) 합집합이 지운 항목을 되살릴 수 있다.
# 그 파일들은 사람이 직접 보고 합쳐야 한다.

# 링크 사냥꾼 기록장 — 로봇이 매 실행 갱신하므로 합집합 병합
collector/link-hunt.json merge=jsonunion

# ── 2026-09-30 — 브라우저 수집 19곳 17분치가 저장 단계 충돌로 통째로 버려진 사고 ──
# 규칙 없는 장부 넷이 충돌했다. 검수 후보·페이지 기록·원문 말뭉치는 합치고(규칙은 merge-json-union.mjs),
# 회전 커서는 매 실행 새로 쓰이므로 리포트처럼 내 쪽을 남긴다. registered.json 은 여전히 일부러 뺀다.
collector/candidates.json            merge=jsonunion
collector/pagination.json            merge=jsonunion
collector/extracted/notices-text.json merge=jsonunion
collector/browser-cursor.json        merge=ours
collector/collect-cursor.json        merge=ours

# ── 학교별 공고 파일 (2026-09-05) ──────────────────────────────────
# 앱이 실제로 읽는 파일이다. 오랫동안 수집 로봇 둘만 썼고 같은 대기줄이라 안 부딪혔는데,
# 링크 사냥꾼·원문 링크 복구가 여기에 고친 주소를 옮겨 쓰면서 **다른 대기줄 넷**이 됐다.
# 규칙이 없으면 충돌 → pull --rebase 3회 실패 → 사냥 결과 전량 유실(이슈 #85·#86 계열).
data/notices/*.json          merge=jsonunion
# 색인은 매 발행마다 새로 쓰인다 — 합칠 내용이 없다(리포트와 같은 취급).
data/notices/index.json      merge=ours

# ── 한국장학재단 선발공고문 사본 (2026-09-12) ──────────────────────────────
# 층2 재단이 학생에게 주는 유일한 '공고 원문'이다(KOSAF 상세는 POST 전용이라 줄 주소가
# 없고, KOSAF 첨부 원주소는 Referer 검사라 앱에서 누르면 "비정상적인 접근"이 뜬다).
# 내용 비교가 의미 없는 이진 파일이라 diff 를 끈다 — collector/extracted 와 같은 취급.
data/kosaf-files/**          -diff

# ── 판정 로봇 장부 (2026-09-30) ──
# 학습 표는 합집합(이름으로) · 후보·씨앗은 매 실행 새로 쓰이므로 내 것
collector/own-programs.json          merge=jsonunion
collector/kind-candidates.json       merge=ours
collector/portal-candidates.json     merge=ours
collector/school-board-seeds.json    merge=ours
# 데이터 관문에 걸린 자동 등록 쉬기 장부 (2026-10-04 · gate-guard·auto-register 가 같은 대기줄에서 쓴다) — 부딪히면 내 것.
# 한쪽 기록을 잃어도 그 공고가 한 번 더 등록됐다 되돌려질 뿐이다(규칙 없이 충돌하면 저장 단계가 통째로 실패한다).
collector/auto-held.json             merge=ours

# ── 교내 소식 (2026-09-30) — 학교별 파일·장부는 합집합, 색인·커서·리포트는 내 것 (공고 파일과 같은 취급) ──
data/news/*.json             merge=jsonunion
data/news/index.json         merge=ours
collector/seen-news.json     merge=jsonunion
collector/news-health.json   merge=jsonunion
collector/news-cursor.json   merge=ours
collector/news-report.md     merge=ours
collector/find-news-boards-report.md merge=ours
# 교내 소식 썸네일 (2026-10-03) — 그림은 이름이 바이트 해시라 같은 이름 = 같은 그림(병합 충돌이 없다) · 장부는 합집합 · 리포트는 매번 새로 쓴다
data/news/img/**             -diff
collector/news-thumbs.json   merge=jsonunion
collector/news-thumbs-report.md merge=ours

# ── 원문 링크 확인 로봇 (2026-10-03) — 매 실행 통째로 새로 쓴다(장부·앱 파일·리포트 모두) → 내 쪽을 남긴다 ──
# 장부(state)는 이 로봇 하나만 쓴다 · 앱 파일(data/link-check.json)은 장부에서 다시 만들어진다(합칠 내용이 없다).
collector/link-check-report.md  merge=ours
collector/link-check-state.json merge=ours
data/link-check.json            merge=ours

# 원문 후보 장부 (2026-10-04) — 원문 링크 확인 로봇(link-check.yml) 하나만 쓴다. 매 실행 통째로 새로 쓰이므로 리포트처럼 내 쪽을 남긴다.
# 후보 파일(collector/link-candidates.json)은 사람·세션이 쓰는 입력이라 여기 넣지 않는다(합집합 규칙이 merge-json-union.mjs 에 없다).
collector/link-candidates-state.json merge=ours
