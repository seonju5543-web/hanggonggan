{
  "_왜 이렇게 돼 있나": "2026-08-29 개발자 지시. 훅은 이미 있었는데 matcher 가 Edit|Write 뿐이라, 이 세션 설정('가능하면 Bash 로 파일을 고쳐라')과 서로를 무력화하고 있었다 — registered.json 도 match-engine.js 도 고쳤지만 훅이 한 번도 안 울렸다. 그래서 matcher 에 Bash 를 넣고, 훅은 도구가 아니라 git 이 본 변경으로 판단한다.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-guard.sh"
          }
        ]
      },
      {
        "matcher": "Skill|Bash|mcp__.*notion.*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/skill-ledger.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.sh"
          }
        ]
      }
    ]
  }
}
